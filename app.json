{
  "expo": {
    "name": "截个提醒",
    "slug": "shot-remind",
    "version": "1.0.0",
    "icon": "./assets/icon.png",
    "scheme": "shotremind",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#131510",
    "platforms": [
      "ios",
      "android"
    ],
    "ios": {
      "bundleIdentifier": "app.shotremind.mobile",
      "supportsTablet": true
    },
    "android": {
      "package": "app.shotremind.mobile",
      "permissions": [
        "android.permission.SCHEDULE_EXACT_ALARM"
      ]
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "选择截图以识别提醒内容。",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#DFFF68"
        }
      ],
      "./plugins/with-ios-pod-deployment-target",
      "./plugins/with-ios-scene"
    ]
  }
}
