{
  "expo": {
    "name": "截个提醒",
    "slug": "shot-remind",
    "version": "1.0.0",
    "icon": "./assets/app-icon.png",
    "scheme": "shotremind",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#131510",
    "platforms": [
      "ios",
      "android"
    ],
    "ios": {
      "bundleIdentifier": "app.shotremind.mobile",
      "supportsTablet": true,
      "infoPlist": {
        "CFBundleAllowMixedLocalizations": true,
        "CFBundleLocalizations": ["zh-Hans"]
      }
    },
    "android": {
      "package": "app.shotremind.mobile",
      "permissions": [
        "android.permission.SCHEDULE_EXACT_ALARM"
      ]
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "从相册选择图片以创建提醒、遮挡隐私或保存办事资料。",
          "cameraPermission": "给物品拍照，记录它的存放位置。",
          "microphonePermission": false
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#DFFF68"
        }
      ],
      [
        "expo-sharing",
        {
          "android": {
            "enabled": true,
            "singleShareMimeTypes": ["image/*"]
          },
          "ios": {
            "enabled": true,
            "appGroupId": "group.app.shotremind.mobile",
            "activationRule": {
              "supportsImageWithMaxCount": 1
            }
          }
        }
      ],
      "./plugins/with-ios-share-name",
      "./plugins/with-ios-pod-deployment-target",
      "./plugins/with-ios-scene"
    ]
  }
}
